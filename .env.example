# Copie para .env (opcional) ou defina as variaveis no shell.
# Em producao, MONGODB_URI e obrigatoria.

SPRING_PROFILES_ACTIVE=dev
MONGODB_URI=mongodb://localhost:27018/usuarios
PORT=8080
EMBEDDED_MONGO_VERSION=8.0.5
# Minimo de 32 caracteres (HS256).
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef