[TEMPLATE]
# Copie para .env (opcional) ou defina as variaveis no shell.
# Em producao, MONGODB_URI e obrigatoria.

SPRING_PROFILES_ACTIVE=dev
MONGODB_URI=mongodb://localhost:27018/usuarios
PORT=8080
EMBEDDED_MONGO_VERSION=8.0.5
# Minimo de 32 caracteres (HS256).
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
# Primeiro ADMIN em banco vazio (fora de dev/test). Remova depois do primeiro login.
APP_BOOTSTRAP_ADMIN_EMAIL=
APP_BOOTSTRAP_ADMIN_PASSWORD=
# Origens de navegador liberadas, separadas por virgula. Vazio desliga o CORS.
CORS_ALLOWED_ORIGINS=
# Perfil demo (somente leitura + usuarios de exemplo). Use SPRING_PROFILES_ACTIVE=demo
# com um MONGODB_URI real; a demo nao sobe o Mongo embarcado.
DEMO_ADMIN_EMAIL=demo@eliascampos.dev
DEMO_ADMIN_PASSWORD=demo-readonly-2026
