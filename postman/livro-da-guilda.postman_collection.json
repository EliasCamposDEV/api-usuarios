{
  "info": {
    "name": "livro-da-guilda",
    "description": "Colecao da API de gerenciamento de usuarios (Java 21 + Spring Boot + MongoDB).\n\nUse o environment `livro-da-guilda demo` para testar a demo publica somente leitura, ou troque `baseUrl` para http://localhost:8080 e rode em dev para exercitar escrita.\n\nRode `Auth > Login` primeiro: o script salva `accessToken` e `refreshToken` nas variaveis da colecao.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "adminEmail", "value": "admin@email.com" },
    { "key": "adminPassword", "value": "admin12345" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "userId", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (salva tokens)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('access e refresh recebidos', () => {",
                  "  pm.expect(body.accessToken).to.be.a('string').and.not.empty;",
                  "  pm.expect(body.refreshToken).to.be.a('string').and.not.empty;",
                  "  pm.expect(body.expiresIn).to.eql(3600);",
                  "});",
                  "pm.collectionVariables.set('accessToken', body.accessToken);",
                  "pm.collectionVariables.set('refreshToken', body.refreshToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/auth/login" },
            "description": "Autentica e devolve accessToken (1 h) e refreshToken (7 dias). O script de teste guarda os dois nas variaveis da colecao."
          }
        },
        {
          "name": "Renovar access token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/auth/refresh" },
            "description": "Rotativo: cada uso invalida o refresh anterior. Se o script do login foi executado, use o valor atual de {{refreshToken}}."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  pm.collectionVariables.set('accessToken', body.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', body.refreshToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": { "raw": "{{baseUrl}}/auth/logout" },
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] },
            "description": "Invalida o refresh token vigente do usuario autenticado. O access token continua valido ate expirar."
          }
        }
      ]
    },
    {
      "name": "Leitura (funciona na demo)",
      "item": [
        {
          "name": "Listar usuarios",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('pagina com content', () => pm.expect(body.content).to.be.an('array'));",
                  "pm.test('metadados de paginacao', () => {",
                  "  pm.expect(body).to.have.property('totalElements');",
                  "  pm.expect(body).to.have.property('totalPages');",
                  "});",
                  "if (body.content.length > 0) {",
                  "  pm.collectionVariables.set('userId', body.content[0].id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users?page=0&size=10&sort=name,asc",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users"],
              "query": [
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" },
                { "key": "sort", "value": "name,asc" }
              ]
            },
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] },
            "description": "Lista paginada. Exige ADMIN. O script guarda o id do primeiro usuario em {{userId}}."
          }
        },
        {
          "name": "Buscar por nome ou e-mail",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users?search=ana&size=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users"],
              "query": [
                { "key": "search", "value": "ana" },
                { "key": "size", "value": "10" }
              ]
            },
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] },
            "description": "Busca case-insensitive em nome e e-mail."
          }
        },
        {
          "name": "Filtrar inativos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users?active=false",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "users"],
              "query": [{ "key": "active", "value": "false" }]
            },
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] },
            "description": "Na demo ha um usuario inativo de proposito (Felipe Andrade)."
          }
        },
        {
          "name": "Detalhe por id",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/users/{{userId}}" },
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] },
            "description": "Rode `Listar usuarios` antes para preencher {{userId}}."
          }
        },
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/actuator/health" },
            "description": "Publico. Em prod/demo nao expoe detalhes de infraestrutura."
          }
        }
      ]
    },
    {
      "name": "Escrita (403 na demo)",
      "item": [
        {
          "name": "Criar usuario",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 local / 403 na demo', () => pm.expect([201, 403]).to.include(pm.response.code));",
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('userId', pm.response.json().id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Maria Silva\",\n  \"email\": \"maria.silva@exemplo.com\",\n  \"password\": \"senha12345\",\n  \"role\": \"USER\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/v1/users" },
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] },
            "description": "Na demo publica retorna 403 READ_ONLY_DEMO. Local em dev cria e devolve 201."
          }
        },
        {
          "name": "Atualizar usuario",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 local / 403 na demo', () => pm.expect([200, 403]).to.include(pm.response.code));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Maria Silva Santos\",\n  \"email\": \"maria.santos@exemplo.com\",\n  \"role\": \"ADMIN\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/v1/users/{{userId}}" },
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] },
            "description": "Atualiza nome, e-mail e papel."
          }
        },
        {
          "name": "Ativar ou desativar",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 local / 403 na demo', () => pm.expect([200, 403]).to.include(pm.response.code));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"active\": false\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/v1/users/{{userId}}/status" },
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] },
            "description": "Usuario inativo nao autentica, mas continua listado."
          }
        },
        {
          "name": "Remover usuario",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('204 local / 403 na demo', () => pm.expect([204, 403]).to.include(pm.response.code));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/users/{{userId}}" },
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] },
            "description": "Remove o usuario de {{userId}}."
          }
        },
        {
          "name": "Trocar a propria senha",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('204 local / 403 na demo', () => pm.expect([204, 403]).to.include(pm.response.code));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"{{adminPassword}}\",\n  \"newPassword\": \"novaSenha123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{baseUrl}}/api/v1/me/password" },
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }] },
            "description": "Derruba os refresh tokens anteriores. Nao use na demo (bloqueado) e, localmente, atualize adminPassword depois."
          }
        }
      ]
    }
  ]
}
